---
import ButtonLink from "@/components/ui/ButtonLink.astro";
---

<section class="hero" id="top">
  <div class="container">
    <p class="eyebrow">Bismillah</p>
    <h1>Code for the Ummah.<br />Charity for eternity.</h1>
    <p class="lead">
      Building free, accessible Islamic technology through open-source
      collaboration.
    </p>
    <p class="note">Open source. Community-driven. Ethically grounded.</p>
    <div class="actions">
      <ButtonLink href="https://github.com/SadaqahCode" blank>
        Explore our projects
      </ButtonLink>
      <ButtonLink href="https://discord.gg/u5s8cJFVuA" variant="ghost" blank>
        Join the community
      </ButtonLink>
    </div>
  </div>
</section>
